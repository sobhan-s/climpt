{
  "name": "climpt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:commit": "pnpm run lint && pnpm run format:check",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,css,html,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.1",
    "typescript": "5.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.5",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1"
  },
  "dependencies": {
    "globals": "^16.5.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
